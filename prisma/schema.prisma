  updatedByUser       User?                @relation("ServiceUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser       User?                @relation("ServiceDeletedBy", fields: [deletedBy], references: [id])
  invoiceBillingItems InvoiceBillingItem[]
  consultingDoctorId  Int?                 @unique
  consultingDoctor    Doctor?              @relation("ConsultingDoctorService", fields: [consultingDoctorId], references: [userId])
  roomId              Int?                 @unique
  room                Room?                @relation("RoomChargeService", fields: [roomId], references: [id])
}

model PathologyTestService {
