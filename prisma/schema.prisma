enum DocumentStoreType {
  LAB_REPORT_PATHOLOGY
  LAB_REPORT_RADIOLOGY
  PATIENT_DOCUMENT
  OTHER
}

model DocumentStore {
  id           Int          @id @default(autoincrement())
  type         DocumentStoreType @default(OTHER)
  path         String
  originalName String
  mimeType     String?
  size         Int
  createdBy    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUser User? @relation("DocumentStoreCreatedBy", fields: [createdBy], references: [id])

  pathologyScannedReports PathologyTestOrder[] @relation("PathologyScannedReport")
  radiologyScannedReports RadiologyTestOrder[] @relation("RadiologyScannedReport")

  @@index([type])
  @@index([createdBy])
  @@index([createdAt])
}

model RadiologyTestResult {
  id         Int     @id @default(autoincrement())
  orderId    Int
  templateId Int
  value      String? @db.LongText

  remark String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    RadiologyTestOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template RadiologyTemplate  @relation(fields: [templateId], references: [id])

  @@index([orderId])
  @@index([templateId])
}

