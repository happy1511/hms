// --------------------
// Configurations
// --------------------
datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// --------------------
// Enums
// --------------------
enum Status {
  active
  inactive
}

enum DoctorType {
  referring
  consulting
}

enum Days {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum Gender {
  Male
  Female
  Other
}

enum MaritalStatus {
  Single
  Married
  Divorced
  Widowed
}

enum PatientType {
  General
  Emergency
  VIP
}

enum IdentityType {
  Passport
  DriverLicense
  NationalID
}

enum DocumentType {
  ALL_TYPES_OF_DOCUMENT
  BIRTH_CERTIFICATE
  CONSENT_FORM
  DEATH_CERTIFICATE
  EMPLOYMENT_CODE_OF_CONDUCT_DOCUMENT
  EMPLOYMENT_EXPERIENCE_LETTER
  EMPLOYMENT_LEGAL_DOCUMENT
  EMPLOYMENT_OFFER_LETTER
  EMPLOYMENT_OTHER_DOCUMENT
  EMPLOYMENT_PAY_SLIP_PAY_ADVICE
  EMPLOYMENT_RECOMMENDATION_LETTER
  EMPLOYMENT_ROLES_AND_RESPONSIBILITIES
  EMPLOYMENT_TERMINATION_LETTER
  EMPLOYMENT_TERMS_AND_CONDITIONS_DOCUMENT
  IDENTIFICATION_DOCUMENT
  INSURANCE_DOCUMENT
  INVOICE_DOCUMENT
  LAB_REPORT
  LEGAL_DOCUMENT
  MEDICAL_CERTIFICATE
  MEDICO_LEGAL_DOCUMENT
  OTHER_CERTIFICATE_OR_CORRESPONDENCE
  OTHER_DOCUMENT
  PATIENT_TRANSFER_DOCUMENT
  PAYMENT_RECEIPT
  PHOTOS
  PRESCRIPTION
  PROFILE_PICTURE
  REPORT
  TRAVEL_DOCUMENT
}

enum AppointmentType {
  CONSULTATION
  CONTRACEPTION
  EDD
  EYE_CARE
  GETTING_STARTED
  MAMMOGRAMS
  OPERATION
  OTHER
  ROUTINE_CHECKUP
  SAME_DAY_ASSISTANCE
  SICK_VISIT
  SURGERY
  TRAVEL_CLINIC
  VACCINATIONS
}

enum ReferenceRangeSex {
  MALE
  FEMALE
  Both
}

enum ServiceType {
  LAB_TEST
  RADIOLOGY_TEST
  OTHER
}

enum ServiceApplicableOn {
  INPATIENT
  OUTPATIENT
  CONSULTATION
  BOTH
}

enum SampleType {
  CSF
  ASCITIC_FLUID
  OTHER
  PERICARDIAL_FLUID
  PERITONEAL_FLUID
  PLASMA
  PLEURAL_FLUID
  PUS
  SEMEN
  SERUM
  SPUTUM
  STOOL
  SYNOVIAL_FLUID
  URINE
  WHOLE_BLOOD
  WHOLE_BLOOD_SERUM
}

enum ResultType {
  NUMERIC
  TEXT
  BOOLEAN
  DETECTION
  IMAGE
  PDF
}

enum ModuleType {
  USER
  DOCTOR_MASTER
  FLOOR_MASTER
  WARD_MASTER
  BED_MASTER
  APPOINTMENT
  PATIENT_MASTER
  BILLING_SECTION_MASTER
  SERVICE_MASTER
  PATHOLOGY_TEST_MASTER
  RADIOLOGY_TEST_MASTER
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
  PRINT
  VIEW
}

enum ContactType {
  EMAIL
  PHONE
  MOBILE
}

enum BloodGroup {
  A_PLUS
  A_NEGATIVE
  B_PLUS
  B_NEGATIVE
  AB_PLUS
  AB_NEGATIVE
  O_PLUS
  O_NEGATIVE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PathologyTestSection {
  BIOCHEMISTRY
  CLINICAL_PATHOLOGY
  COAGULATION
  CYTOGENETICS
  CYTOPATHOLOGY
  HAEMATOLOGY
  HISTOPATHOLOGY
  HORMONES_IMMUNOLOGY
  IMMUNOASSAY
  IMMUNOFLUORESCENCE
  MICROBIOLOGY
  MOLECULAR_BIOLOGY
  NEPHELOMETRY
  SEROLOGY
  TRANSFUSION_MEDICINE
}

enum ContainerType {
  CLOT_ACTIVATOR
  EDTA
  EDTA_CLOT_ACTIVATOR
  EDTA_CITRATE_ACTIVATOR
  SODIUM_CITRATE_3_2
  OTHER
}

enum RadiologySection {
  COAGULATION
  CT_SCAN
  CYTOGENETICS
  CYTOPATHOLOGY
  HISTOPATHOLOGY
  IMMUNOASSAY
  IMMUNOFLUORESCENCE
  MICROBIOLOGY
  MOLECULAR_BIOLOGY
  MRI
  NEPHELOMETRY
  SONOGRAPHY_ULTRASOUND
  TRANSFUSION_MEDICINE
  X_RAY
}

// --------------------
// Models
// --------------------

// -------------------- Permission Management --------------------
model Action {
  id          Int          @id @default(autoincrement())
  name        ActionType   @unique
  permissions Permission[]
}

model Module {
  id          Int          @id @default(autoincrement())
  name        ModuleType   @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now())
  permissions Permission[]
}

model Permission {
  id       Int @id @default(autoincrement())
  moduleId Int
  actionId Int

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  userPermissions UserPermission[]

  @@unique([moduleId, actionId])
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionId, userId])
}

// -------------------- User Management --------------------

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  loginId  String  @unique
  password String
  status   Status  @default(active)
  name     String?
  doctor   Doctor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions UserPermission[]
}

model Doctor {
  userId                   Int        @id
  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber            String     @unique
  specialization           String
  qualifications           String
  yearsExperience          Int
  department               String?
  designation              String?
  doctorType               DoctorType
  email                    String     @unique
  phoneNumber              String     @unique
  emergencyContact         String?
  consultationStartingTime String?
  consultationEndingTime   String?

  availableDays DoctorAvailableDay[]
  appointment   Appointment[]
}

model DoctorAvailableDay {
  id       Int    @id @default(autoincrement())
  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  day      Days

  @@unique([doctorId, day])
}

model PatientContact {
  id    Int         @id @default(autoincrement())
  type  ContactType
  value String

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model emergencyContact {
  id       Int     @id @default(autoincrement())
  name     String
  contact  String
  relation String
  email    String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientNotes {
  id   Int    @id @default(autoincrement())
  type String
  note String

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientRelations {
  id      Int     @id @default(autoincrement())
  type    String
  name    String
  contact String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientAddress {
  id               Int     @id @default(autoincrement())
  type             String
  country          String
  addressLineOne   String
  addressLineTwo   String?
  addressLineThree String?
  city             String
  state            String
  postalCode       String

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientIdentification {
  id     Int          @id @default(autoincrement())
  type   IdentityType
  number String
  active Status

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Patient {
  id                 Int           @id @default(autoincrement())
  uhid               String        @unique @default(uuid())
  firstName          String
  middleName         String?
  lastName           String
  preferredName      String
  dob                DateTime
  identificationMark String?
  gender             Gender
  maritalStatus      MaritalStatus
  religion           String
  bloodGroup         BloodGroup
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  appointment       Appointment[]
  contacts          PatientContact[]
  relations         PatientRelations[]
  addresses         PatientAddress[]
  identifications   PatientIdentification[]
  emergencyContacts emergencyContact[]
  notes             PatientNotes[]
}

// -------------------- Facility Management --------------------
model Floor {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  departments Ward[]
  status      Status   @default(active)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ward {
  id          Int      @id @default(autoincrement())
  floorId     Int
  floor       Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name        String   @unique
  description String?
  status      Status   @default(active)
  beds        Bed[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bed {
  id        Int      @id @default(autoincrement())
  wardId    Int
  ward      Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  bedNumber String
  status    Status   @default(active)
  occupied  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------- Appointment Management --------------------
model Appointment {
  id              Int               @id @default(autoincrement())
  patientId       Int
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        Int
  doctor          Doctor            @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  appointmentDate DateTime
  remarks         String?
  type            AppointmentType
  status          AppointmentStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// -------------------- Pathology Lab Test Management --------------------
model PathologyTest {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  alias       String
  price       Float
  status      Status               @default(active)
  section     PathologyTestSection
  container   ContainerType
  sampleType  SampleType
  footerNotes String?

  parameters PathologyTestParameter[]
  services   PathologyTestService[]

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  testHeaders PathologyTestHeader[]
}

model PathologyTestHeader {
  id           Int      @id @default(autoincrement())
  name         String
  note         String?
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  testId         Int
  test           PathologyTest            @relation(fields: [testId], references: [id], onDelete: Cascade)
  testParameters PathologyTestParameter[]
}

model PathologyTestParameter {
  id                Int                  @id @default(autoincrement())
  headerId          Int?
  header            PathologyTestHeader? @relation(fields: [headerId], references: [id], onDelete: Cascade)
  name              String
  displayOrder      Int
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  test              PathologyTest?       @relation(fields: [testId], references: [id])
  testId            Int?
  isDescriptiveOnly Boolean              @default(false)
  referenceRanges   ReferenceRange[]
  parameterOptions  ParameterOptions[]
}

model ParameterOptions {
  id              Int                    @id @default(autoincrement())
  testParameterId Int
  testParameter   PathologyTestParameter @relation(fields: [testParameterId], references: [id], onDelete: Cascade)
  value           String
}

model ReferenceRange {
  id Int @id @default(autoincrement())

  testParameterId Int
  testParameter   PathologyTestParameter @relation(fields: [testParameterId], references: [id], onDelete: Cascade)

  applicableGender ReferenceRangeSex
  lowerDay         String?
  upperDay         String?
  lowerMonth       String?
  upperMonth       String?
  lowerYear        String?
  upperYear        String?
  lowerRange       String?
  upperRange       String?
  unit             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------- Radiology Test Management --------------------
model RadiologyTest {
  id      Int              @id @default(autoincrement())
  name    String           @unique
  alias   String
  price   Float
  status  Status           @default(active)
  section RadiologySection

  templates RadiologyTemplate[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  radiologyTestServices RadiologyTestService[]
}

model RadiologyTemplate {
  id      Int              @id @default(autoincrement())
  section RadiologySection
  name    String
  content String
  status  Status           @default(active)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  radiologyTest   RadiologyTest? @relation(fields: [radiologyTestId], references: [id])
  radiologyTestId Int?
}

// -------------------- Service Management --------------------
model BillingSection {
  id              Int                     @id @default(autoincrement())
  name            String                  @unique
  description     String?
  status          Status                  @default(active)
  services        BillingSectionService[]
  isPathologyTest Boolean                 @default(false)
  isRadiologyTest Boolean                 @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id                Int                     @id @default(autoincrement())
  name              String                  @unique
  description       String?
  type              ServiceType
  price             Float
  discountAvailable Boolean                 @default(false)
  maxDiscount       Float?
  applicableOn      ServiceApplicableOn     @default(BOTH)
  status            Status                  @default(active)
  billingSections   BillingSectionService[]
  pathologyTests    PathologyTestService[]
  radiologyTests    RadiologyTestService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BillingSectionService {
  id               Int @id @default(autoincrement())
  billingSectionId Int
  serviceId        Int

  billingSection BillingSection @relation(fields: [billingSectionId], references: [id], onDelete: Cascade)
  service        Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([billingSectionId, serviceId])
}

model PathologyTestService {
  id        Int @id @default(autoincrement())
  testId    Int
  serviceId Int

  test    PathologyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, serviceId])
}

model RadiologyTestService {
  id        Int @id @default(autoincrement())
  testId    Int
  serviceId Int

  test    RadiologyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, serviceId])
}
