  ipdBedAllocationId      Int?         @unique
  quantity                Int
  rate                    Float
  discountType            DiscountType
  discountValue           Float
  total                   Float
  updateReason            String?      @db.LongText

  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingSection        BillingSection        @relation(fields: [billingSectionId], references: [id], onDelete: Cascade)
  invoiceBillingSection InvoiceBillingSection @relation(fields: [invoiceBillingSectionId], references: [id], onDelete: Cascade)
  service               Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  invoice               Invoice?              @relation(fields: [invoiceId], references: [id])
  ipdBedAllocation      IpdBedAllocation?     @relation(fields: [ipdBedAllocationId], references: [id], onDelete: SetNull)
  invoiceId             Int?
  createdByUser         User?                 @relation("InvoiceBillingItemCreatedBy", fields: [createdBy], references: [id])
  updatedByUser         User?                 @relation("InvoiceBillingItemUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser         User?                 @relation("InvoiceBillingItemDeletedBy", fields: [deletedBy], references: [id])
  pathologyOrders       PathologyTestOrder[]  @relation("InvoiceBillingItemPathologyOrders")
  radiologyOrders       RadiologyTestOrder[]  @relation("InvoiceBillingItemRadiologyOrders")

  @@index([invoiceId])
  @@index([billingSectionId])
  @@index([invoiceBillingSectionId])
  @@index([serviceId])
  @@index([ipdBedAllocationId])
}

model InvoiceBillingSection {
  id               Int          @id @default(autoincrement())
  invoiceId        Int
  billingSectionId Int
  discountValue    Float        @default(0)
  discountType     DiscountType @default(VALUE)
  createdBy        Int?
  updatedBy        Int?
  deletedBy        Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  invoice        Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  billingSection BillingSection       @relation(fields: [billingSectionId], references: [id], onDelete: Cascade)
  items          InvoiceBillingItem[]
  createdByUser  User?                @relation("InvoiceBillingSectionCreatedBy", fields: [createdBy], references: [id])
  updatedByUser  User?                @relation("InvoiceBillingSectionUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser  User?                @relation("InvoiceBillingSectionDeletedBy", fields: [deletedBy], references: [id])

  @@unique([invoiceId, billingSectionId])
  @@index([invoiceId])
  @@index([billingSectionId])
}

model Invoice {
  id              Int                     @id @default(autoincrement())
  rate            Float
  discountType    DiscountType
  discountValue   Float
  total           Float
  isPaid          Boolean                 @default(false)
  isFree          Boolean                 @default(false)
  billingType     PaymentCategory
  isDeleted       Boolean                 @default(false)
  billingItems    InvoiceBillingItem[]
  billingSections InvoiceBillingSection[]
  transactions    Transaction[]

  opd       Opd?
  ipd       Ipd?
  drugBills DrugBill?

  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  createdByUser User? @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("InvoiceUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User? @relation("InvoiceDeletedBy", fields: [deletedBy], references: [id])

  @@index([createdAt])
  @@index([createdBy])
  @@index([isPaid])
}

// -------------------- OPD File Management --------------------

