  generalExaminations  String? @db.LongText
  systemicExaminations String? @db.LongText
  diagnosis            String? @db.LongText
  chronicIllness       String? @db.LongText

  opd                   Opd                     @relation(fields: [opdId], references: [id], onDelete: Cascade)
  vitals                Vital                   @relation(fields: [vitalsId], references: [id], onDelete: Cascade)
  advisedPathologyTests AdvisedPathologyTests[]
  advisedRadiologyTests AdvisedRadiologyTests[]
}

// -------------------- Opd Management --------------------

model Opd {
  id                 Int        @id @default(autoincrement())
  patientId          Int
  arrivalState       OpdArrival
  status             OpdStatus  @default(IN_QUEUE)
  opdDateTime        DateTime   @default(now())
  remarks            String?
  consultantDoctorId Int
  referringDoctorId  Int?
  invoiceId          Int        @unique

  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUser         User?                   @relation("OpdCreatedBy", fields: [createdBy], references: [id])
  updatedByUser         User?                   @relation("OpdUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser         User?                   @relation("OpdDeletedBy", fields: [deletedBy], references: [id])
  consultantDoctor      Doctor                  @relation("ConsultantDoctorOpds", fields: [consultantDoctorId], references: [userId], onDelete: Cascade)
  referringDoctor       Doctor?                 @relation("ReferringDoctorOpds", fields: [referringDoctorId], references: [userId], onDelete: Cascade)
  patient               Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invoice               Invoice                 @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  consultation          OpdConsultation?
  vital                 Vital?
  advisedPathologyTests AdvisedPathologyTests[]
  advisedRadiologyTests AdvisedRadiologyTests[]
  prescription          Prescription?
  prescribedDrugs       PrescribedDrugs[]
  pathologyTestOrders   PathologyTestOrder[]
  radiologyTestOrders   RadiologyTestOrder[]

  @@index([patientId])
  @@index([consultantDoctorId])
  @@index([referringDoctorId])
  @@index([invoiceId])
  @@index([status])
  @@index([opdDateTime])
  @@index([createdAt])
}

// -------------------- Ipd Management --------------------

model Ipd {
  id                 Int         @id @default(autoincrement())
  patientId          Int
  arrivalState       IpdArrival
  remarks            String?
  consultantDoctorId Int
  referringDoctorId  Int?
  bedId              Int
  invoiceId          Int         @unique
  careType           IpdCareType @default(MEDICAL)
  isDischarged       Boolean     @default(false)
  isDayCare          Boolean     @default(false)
  isMlcPatient       Boolean     @default(false)
  mlcDeclaredById    Int?
  mlcDeclarationDate DateTime?
  ipdDateTime        DateTime    @default(now())
  dischargedAt       DateTime?
  dischargedById     Int?

  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUser       User?                @relation("IpdCreatedBy", fields: [createdBy], references: [id])
  updatedByUser       User?                @relation("IpdUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser       User?                @relation("IpdDeletedBy", fields: [deletedBy], references: [id])
  dischargedByUser    User?                @relation("IpdDischargedBy", fields: [dischargedById], references: [id])
  mlcDeclaredByUser   User?                @relation("IpdMlcDeclaredBy", fields: [mlcDeclaredById], references: [id])
  bed                 Bed                  @relation("BedToIpd", fields: [bedId], references: [id], onDelete: Cascade)
  currentBedLink      Bed?                 @relation("CurrentIpd")
  consultantDoctor    Doctor               @relation("ConsultantDoctorIpds", fields: [consultantDoctorId], references: [userId], onDelete: Cascade)
  referringDoctor     Doctor?              @relation("ReferringDoctorIpds", fields: [referringDoctorId], references: [userId], onDelete: Cascade)
  patient             Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invoice             Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  dischargeSummary    IpdDischargeSummary?
  bedAllocations      IpdBedAllocation[]
  pathologyTestOrders PathologyTestOrder[]
  radiologyTestOrders RadiologyTestOrder[]
  room                Room?                @relation(fields: [roomId], references: [id])
  roomId              Int?

  @@index([patientId])
  @@index([consultantDoctorId])
  @@index([referringDoctorId])
  @@index([bedId])
  @@index([invoiceId])
  @@index([isDischarged])
  @@index([isDayCare])
  @@index([isMlcPatient])
  @@index([mlcDeclarationDate])
  @@index([ipdDateTime])
  @@index([dischargedAt])
  @@index([createdAt])
}

model IpdBedAllocation {
  id           Int      @id @default(autoincrement())
  ipdId        Int
  bedId        Int
  roomId       Int
  fromDateTime DateTime
  toDateTime   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ipd  Ipd  @relation(fields: [ipdId], references: [id], onDelete: Cascade)
  bed  Bed  @relation(fields: [bedId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  invoiceBillingItem InvoiceBillingItem?

  @@index([ipdId])
  @@index([bedId])
  @@index([roomId])
  @@index([fromDateTime])
  @@index([toDateTime])
}

model IpdDischargeSummary {
  id                               Int      @id @default(autoincrement())
  ipdId                            Int      @unique
  ipdDateTime                      DateTime?
  isUnfitForFurtherManagement      Boolean  @default(false)
  diagnosis                        String?  @db.LongText
  procedureDate                    DateTime?
  procedure                        String?  @db.LongText
  courseInHospital                 String?  @db.LongText
  investigationResults             String?  @db.LongText
  allergies                        String?
  diet                             String?
  physicalActivity                 String?
  followUpDate                     DateTime?
  otherAdvice                      String?  @db.LongText
  urgentCareWhen                   String?
  isTransferred                    Boolean  @default(false)
  remarks                          String?  @db.LongText

  followUpAfterDays                Int?
  followUpAdvice                   String?  @db.LongText

  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  drugs                            IpdDischargeDrug[]
  ipd                              Ipd      @relation(fields: [ipdId], references: [id], onDelete: Cascade)

  @@index([ipdId])
  @@index([followUpDate])
}

model IpdDischargeDrug {
  id                 Int     @id @default(autoincrement())
  dischargeSummaryId Int
  drugId             Int
  frequency          Int
  days               Int
  unit               String?
  route              String
  remarks            String?

  dischargeSummary IpdDischargeSummary @relation(fields: [dischargeSummaryId], references: [id], onDelete: Cascade)
  drug            Drug                @relation(fields: [drugId], references: [id], onDelete: Restrict)

  @@index([dischargeSummaryId])
  @@index([drugId])
}

// -------------------- Company Details --------------------

model CompanyDetails {
  id      Int    @id @default(autoincrement())
  name    String @default("")
  address String @default("")
  mobile  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------- Drug Management --------------------

model DrugBill {
  id        Int     @id @default(autoincrement())
  name      String
  patientId Int?
  doctorId  Int?
  invoiceId Int     @unique
  isDeleted Boolean @default(false)
  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  patient       Patient?       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Doctor?        @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  createdByUser User?          @relation("DrugBillCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?          @relation("DrugBillUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?          @relation("DrugBillDeletedBy", fields: [deletedBy], references: [id])
  saleItems     DrugSaleItem[]

  @@index([invoiceId])
  @@index([patientId])
  @@index([doctorId])
}

model DrugBillingCategory {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  isDeleted   Boolean @default(false)
  createdBy   Int?
  updatedBy   Int?
  deletedBy   Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdByUser User?    @relation("DrugBillingCategoryCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("DrugBillingCategoryUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?    @relation("DrugBillingCategoryDeletedBy", fields: [deletedBy], references: [id])

  purchaseItems PurchaseItem[]
}

model Drug {
  id             Int     @id @default(autoincrement())
  name           String
  description    String?
  hsnCode        Int
  gstPercentage  Float   @default(0)
  cGstPercentage Float   @default(0)
  sGstPercentage Float   @default(0)
  iGstPercentage Float   @default(0)
  manufacturer   String
  unit           String
  isDeleted      Boolean @default(false)
  createdBy      Int?
  updatedBy      Int?
  deletedBy      Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdByUser User?    @relation("DrugCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("DrugUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?    @relation("DrugDeletedBy", fields: [deletedBy], references: [id])

  inventoryItems InventoryItems[]
  purchaseItems  PurchaseItem[]
  ipdDischargeDrugs IpdDischargeDrug[]
}

model DrugSupplier {
  id        Int     @id @default(autoincrement())
  name      String
  gstIn     Int?
  email     String?
  phone     Int
  isDeleted Boolean @default(false)
  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  createdByUser User?    @relation("DrugSupplierCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?    @relation("DrugSupplierUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?    @relation("DrugSupplierDeletedBy", fields: [deletedBy], references: [id])

  inventoryItems InventoryItems[]
  purchaseOrders PurchaseOrder[]
}

model InventoryItems {
  id                Int      @id @default(autoincrement())
  drugId            Int
  batchNo           Int
  expiryDate        DateTime
  manufacturingDate DateTime
  purchasePrice     Float
  mrp               Float
  sellingPrice      Float
  wholeSalePrice    Float
  quantityInStock   Int
  supplierId        Int
  createdBy         Int?
  updatedBy         Int?
  deletedBy         Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  drug          Drug           @relation(fields: [drugId], references: [id], onDelete: Cascade)
  supplier      DrugSupplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation("InventoryItemCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?          @relation("InventoryItemUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?          @relation("InventoryItemDeletedBy", fields: [deletedBy], references: [id])
  grnItems      GRNItems[]
  saleItems     DrugSaleItem[]

  @@index([drugId])
  @@index([supplierId])
  @@index([expiryDate])
}

model DrugSaleItem {
  id              Int          @id @default(autoincrement())
  drugBillId      Int
  inventoryItemId Int
  quantity        Int
  rate            Float
  discountType    DiscountType @default(VALUE)
  discountValue   Float        @default(0)
  taxableAmount   Float        @default(0)
  gstPercentage   Float        @default(0)
  cGstPercentage  Float        @default(0)
  sGstPercentage  Float        @default(0)
  iGstPercentage  Float        @default(0)
  gstAmount       Float        @default(0)
  cGstAmount      Float        @default(0)
  sGstAmount      Float        @default(0)
  iGstAmount      Float        @default(0)
  total           Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drugBill      DrugBill       @relation(fields: [drugBillId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItems @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([drugBillId])
  @@index([inventoryItemId])
}

model GRNItems {
  id              Int @id @default(autoincrement())
  purchaseItemId  Int
  inventoryItemId Int
  grnId           Int

  grn           GRN            @relation(fields: [grnId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItems @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  purchaseItem  PurchaseItem   @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)
}

model GRN {
  id        Int  @id @default(autoincrement())
  orderId   Int  @unique
  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  grnItems      GRNItems[]
  order         PurchaseOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdByUser User?          @relation("GRNCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?          @relation("GRNUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?          @relation("GRNDeletedBy", fields: [deletedBy], references: [id])
}

model PurchaseItem {
  id                 Int   @id @default(autoincrement())
  drugId             Int
  quantity           Int
  categoryId         Int
  discountPercentage Float @default(0)
  rate               Float @default(0)
  total              Float @default(0)
  purchaseOrderId    Int

  category      DrugBillingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  drug          Drug                @relation(fields: [drugId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id])
  grnItems      GRNItems[]
}

model PurchaseOrder {
  id         Int                 @id @default(autoincrement())
  supplierId Int
  grnId      Int?                @unique
  remarks    String?
  orderDate  DateTime            @default(now())
  status     PurchaseOrderStatus @default(draft)
  isDeleted  Boolean             @default(false)
  createdBy  Int?
  updatedBy  Int?
  deletedBy  Int?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @default(now()) @updatedAt

  supplier      DrugSupplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items         PurchaseItem[]
  grn           GRN?
  createdByUser User?          @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?          @relation("PurchaseOrderUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?          @relation("PurchaseOrderDeletedBy", fields: [deletedBy], references: [id])
}

// -------------------- Pharmacy Management --------------------
