// -------------------- Location Management --------------------

model Location {
  id               Int              @id @default(autoincrement())
  city             String           @db.VarChar(100)
  state            String           @db.VarChar(100)
  country          String           @db.VarChar(100)
  postcode         String           @db.VarChar(20)
  postName         String           @default("") @db.VarChar(191)
  isDeleted        Boolean          @default(false)
  createdBy        Int?
  updatedBy        Int?
  deletedBy        Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  patientAddresses PatientAddress[]
  userAddresses    User[]           @relation("UserAddressLocation")

  createdByUser User? @relation("LocationCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("LocationUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User? @relation("LocationDeletedBy", fields: [deletedBy], references: [id])

  @@unique([city, state, country, postcode, postName])
  @@index([country])
  @@index([state])
  @@index([city])
  @@index([postcode])
  @@index([postName])
}

// -------------------- Permission Management --------------------
model Action {
  id          Int          @id @default(autoincrement())
  name        ActionType   @unique
  permissions Permission[]
}

model Module {
  id          Int          @id @default(autoincrement())
  name        ModuleType   @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now())
  permissions Permission[]
}

model Permission {
  id       Int @id @default(autoincrement())
  moduleId Int
  actionId Int

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  userPermissions UserPermission[]

  @@unique([moduleId, actionId])
  @@index([moduleId])
  @@index([actionId])
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionId, userId])
  @@index([userId])
  @@index([permissionId])
}

