  test    RadiologyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, serviceId])
  @@index([testId])
  @@index([serviceId])
}

// -------------------- Transactions Management --------------------
model Transaction {
  id              Int             @id @default(autoincrement())
  opdId           Int?
  amount          Float
  mode            PaymentMode
  transactionType TransactionType @default(PAYMENT)
  remarks         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  receivedById Int

  receivedBy User     @relation(fields: [receivedById], references: [id])
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId  Int?

  @@index([invoiceId])
}

model InvoiceBillingItem {
  id               Int          @id @default(autoincrement())
  opdId            Int?
  billingSectionId Int
  invoiceBillingSectionId Int
  serviceId        Int
  isLocked         Boolean      @default(false)
  ipdBedAllocationId Int?       @unique
  quantity         Int
  rate             Float
  discountType     DiscountType
  discountValue    Float
  total            Float
