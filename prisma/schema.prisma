// --------------------
// Models
// --------------------

// -------------------- Location Management --------------------

model Location {
  id               Int              @id @default(autoincrement())
  city             String
  state            String
  country          String
  postcode         String
  isDeleted        Boolean          @default(false)
  createdBy        Int?
  updatedBy        Int?
  deletedBy        Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  patientAddresses PatientAddress[]

  createdByUser User? @relation("LocationCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("LocationUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User? @relation("LocationDeletedBy", fields: [deletedBy], references: [id])

  @@index([city])
  @@index([postcode])
}

// -------------------- Permission Management --------------------
model Action {
  id          Int          @id @default(autoincrement())
  name        ActionType   @unique
  permissions Permission[]
}

model Module {
  id          Int          @id @default(autoincrement())
  name        ModuleType   @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now())
  permissions Permission[]
}

model Permission {
  id       Int @id @default(autoincrement())
  moduleId Int
  actionId Int

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  userPermissions UserPermission[]

  @@unique([moduleId, actionId])
  @@index([moduleId])
  @@index([actionId])
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionId, userId])
  @@index([userId])
  @@index([permissionId])
}

// -------------------- User Management --------------------

model User {
  id             Int            @id @default(autoincrement())
  username       String         @unique
  loginId        String         @unique
  title          NameTitle      @default(MR)
  password       String
