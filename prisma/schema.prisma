  isDeleted      Boolean        @default(false)
  name           String?
  firstName      String         @default("")
  middleName     String?
  lastName       String         @default("")
  preferredName  String         @default("")
  gender         Gender         @default(Other)
  dob            DateTime?
  maritalStatus  MaritalStatus?
  address        String?
  city           String?
  country        String?
  state          String?
  postcode       String?
  contactNumber  String         @unique
  email          String?
  identityType   IdentityType?
  identityNumber String?
  education      String?
  qualifications String?
  department     String?
  createdBy      Int?
  updatedBy      Int?
  deletedBy      Int?
  doctor         Doctor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions                UserPermission[]
  transactions               Transaction[]
  collectedIncomes           Income[]                 @relation("CollectedIncome")
  verifiedPathology          PathologyTestOrder[]     @relation("verifiedPathology")
  resultEnteredPathology     PathologyTestOrder[]     @relation("resultEnteredPathology")
  sampleTakenPathology       PathologyTestOrder[]     @relation("sampleTakenPathology")
  cancelledTakenPathology    PathologyTestOrder[]     @relation("cancelledTakenPathology")
  verifiedRadiology          RadiologyTestOrder[]     @relation("verifiedRadiology")
  resultEnteredRadiology     RadiologyTestOrder[]     @relation("resultEnteredRadiology")
  sampleTakenRadiology       RadiologyTestOrder[]     @relation("sampleTakenRadiology")
  cancelledTakenRadiology    RadiologyTestOrder[]     @relation("cancelledTakenRadiology")
  createdDocuments           DocumentStore[]          @relation("DocumentStoreCreatedBy")
  createdByUser              User?                    @relation("UserCreatedBy", fields: [createdBy], references: [id])
  updatedByUser              User?                    @relation("UserUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser              User?                    @relation("UserDeletedBy", fields: [deletedBy], references: [id])
  createdUsers               User[]                   @relation("UserCreatedBy")
  updatedUsers               User[]                   @relation("UserUpdatedBy")
  deletedUsers               User[]                   @relation("UserDeletedBy")
  createdLocations           Location[]               @relation("LocationCreatedBy")
  updatedLocations           Location[]               @relation("LocationUpdatedBy")
  deletedLocations           Location[]               @relation("LocationDeletedBy")
  createdDoctors             Doctor[]                 @relation("DoctorCreatedBy")
  updatedDoctors             Doctor[]                 @relation("DoctorUpdatedBy")
  deletedDoctors             Doctor[]                 @relation("DoctorDeletedBy")
  createdPatients            Patient[]                @relation("PatientCreatedBy")
  updatedPatients            Patient[]                @relation("PatientUpdatedBy")
  deletedPatients            Patient[]                @relation("PatientDeletedBy")
  createdDepartments         Department[]             @relation("DepartmentCreatedBy")
  updatedDepartments         Department[]             @relation("DepartmentUpdatedBy")
  deletedDepartments         Department[]             @relation("DepartmentDeletedBy")
  createdRoomTypes           RoomType[]               @relation("RoomTypeCreatedBy")
  updatedRoomTypes           RoomType[]               @relation("RoomTypeUpdatedBy")
  deletedRoomTypes           RoomType[]               @relation("RoomTypeDeletedBy")
  createdRooms               Room[]                   @relation("RoomCreatedBy")
  updatedRooms               Room[]                   @relation("RoomUpdatedBy")
  deletedRooms               Room[]                   @relation("RoomDeletedBy")
  createdBeds                Bed[]                    @relation("BedCreatedBy")
  updatedBeds                Bed[]                    @relation("BedUpdatedBy")
  deletedBeds                Bed[]                    @relation("BedDeletedBy")
  createdAppointments        Appointment[]            @relation("AppointmentCreatedBy")
  updatedAppointments        Appointment[]            @relation("AppointmentUpdatedBy")
  deletedAppointments        Appointment[]            @relation("AppointmentDeletedBy")
  createdPathologyTests      PathologyTest[]          @relation("PathologyTestCreatedBy")
  updatedPathologyTests      PathologyTest[]          @relation("PathologyTestUpdatedBy")
  deletedPathologyTests      PathologyTest[]          @relation("PathologyTestDeletedBy")
  createdPathologyHeaders    PathologyTestHeader[]    @relation("PathologyTestHeaderCreatedBy")
  updatedPathologyHeaders    PathologyTestHeader[]    @relation("PathologyTestHeaderUpdatedBy")
  deletedPathologyHeaders    PathologyTestHeader[]    @relation("PathologyTestHeaderDeletedBy")
  createdPathologyParameters PathologyTestParameter[] @relation("PathologyTestParameterCreatedBy")
  updatedPathologyParameters PathologyTestParameter[] @relation("PathologyTestParameterUpdatedBy")
  deletedPathologyParameters PathologyTestParameter[] @relation("PathologyTestParameterDeletedBy")
  createdReferenceRanges     ReferenceRange[]         @relation("ReferenceRangeCreatedBy")
  updatedReferenceRanges     ReferenceRange[]         @relation("ReferenceRangeUpdatedBy")
  deletedReferenceRanges     ReferenceRange[]         @relation("ReferenceRangeDeletedBy")
  createdRadiologyTests      RadiologyTest[]          @relation("RadiologyTestCreatedBy")
  updatedRadiologyTests      RadiologyTest[]          @relation("RadiologyTestUpdatedBy")
  deletedRadiologyTests      RadiologyTest[]          @relation("RadiologyTestDeletedBy")
  createdRadiologyTemplates  RadiologyTemplate[]      @relation("RadiologyTemplateCreatedBy")
  updatedRadiologyTemplates  RadiologyTemplate[]      @relation("RadiologyTemplateUpdatedBy")
  deletedRadiologyTemplates  RadiologyTemplate[]      @relation("RadiologyTemplateDeletedBy")
  createdBillingSections     BillingSection[]         @relation("BillingSectionCreatedBy")
  updatedBillingSections     BillingSection[]         @relation("BillingSectionUpdatedBy")
  deletedBillingSections     BillingSection[]         @relation("BillingSectionDeletedBy")
  createdServices            Service[]                @relation("ServiceCreatedBy")
  updatedServices            Service[]                @relation("ServiceUpdatedBy")
  deletedServices            Service[]                @relation("ServiceDeletedBy")
  createdIncomes             Income[]                 @relation("IncomeCreatedBy")
  updatedIncomes             Income[]                 @relation("IncomeUpdatedBy")
  deletedIncomes             Income[]                 @relation("IncomeDeletedBy")
  createdExpenses            Expense[]                @relation("ExpenseCreatedBy")
  updatedExpenses            Expense[]                @relation("ExpenseUpdatedBy")
  deletedExpenses            Expense[]                @relation("ExpenseDeletedBy")
  createdInvoiceItems        InvoiceBillingItem[]     @relation("InvoiceBillingItemCreatedBy")
  updatedInvoiceItems        InvoiceBillingItem[]     @relation("InvoiceBillingItemUpdatedBy")
  deletedInvoiceItems        InvoiceBillingItem[]     @relation("InvoiceBillingItemDeletedBy")
  createdInvoiceBillingSections InvoiceBillingSection[] @relation("InvoiceBillingSectionCreatedBy")
  updatedInvoiceBillingSections InvoiceBillingSection[] @relation("InvoiceBillingSectionUpdatedBy")
  deletedInvoiceBillingSections InvoiceBillingSection[] @relation("InvoiceBillingSectionDeletedBy")
  createdInvoices            Invoice[]                @relation("InvoiceCreatedBy")
  updatedInvoices            Invoice[]                @relation("InvoiceUpdatedBy")
  deletedInvoices            Invoice[]                @relation("InvoiceDeletedBy")
  createdOpds                Opd[]                    @relation("OpdCreatedBy")
  updatedOpds                Opd[]                    @relation("OpdUpdatedBy")
  deletedOpds                Opd[]                    @relation("OpdDeletedBy")
  createdIpds                Ipd[]                    @relation("IpdCreatedBy")
  updatedIpds                Ipd[]                    @relation("IpdUpdatedBy")
  deletedIpds                Ipd[]                    @relation("IpdDeletedBy")
  dischargedIpds             Ipd[]                    @relation("IpdDischargedBy")
  mlcDeclaredIpds            Ipd[]                    @relation("IpdMlcDeclaredBy")
  createdDrugCategories      DrugBillingCategory[]    @relation("DrugBillingCategoryCreatedBy")
  updatedDrugCategories      DrugBillingCategory[]    @relation("DrugBillingCategoryUpdatedBy")
  deletedDrugCategories      DrugBillingCategory[]    @relation("DrugBillingCategoryDeletedBy")
  createdDrugs               Drug[]                   @relation("DrugCreatedBy")
  updatedDrugs               Drug[]                   @relation("DrugUpdatedBy")
  deletedDrugs               Drug[]                   @relation("DrugDeletedBy")
  createdDrugSuppliers       DrugSupplier[]           @relation("DrugSupplierCreatedBy")
  updatedDrugSuppliers       DrugSupplier[]           @relation("DrugSupplierUpdatedBy")
  deletedDrugSuppliers       DrugSupplier[]           @relation("DrugSupplierDeletedBy")
  createdInventoryItems      InventoryItems[]         @relation("InventoryItemCreatedBy")
  updatedInventoryItems      InventoryItems[]         @relation("InventoryItemUpdatedBy")
  deletedInventoryItems      InventoryItems[]         @relation("InventoryItemDeletedBy")
  createdGrns                GRN[]                    @relation("GRNCreatedBy")
  updatedGrns                GRN[]                    @relation("GRNUpdatedBy")
  deletedGrns                GRN[]                    @relation("GRNDeletedBy")
  createdPurchaseOrders      PurchaseOrder[]          @relation("PurchaseOrderCreatedBy")
  updatedPurchaseOrders      PurchaseOrder[]          @relation("PurchaseOrderUpdatedBy")
  deletedPurchaseOrders      PurchaseOrder[]          @relation("PurchaseOrderDeletedBy")
  createdDrugBills           DrugBill[]               @relation("DrugBillCreatedBy")
  updatedDrugBills           DrugBill[]               @relation("DrugBillUpdatedBy")
  deletedDrugBills           DrugBill[]               @relation("DrugBillDeletedBy")

  @@index([isDeleted])
  @@index([createdAt])
}

model Doctor {
  userId                   Int        @id
  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber            String?    @unique
  specialization           String?
  qualifications           String?
  yearsExperience          Int?
  department               String?
  designation              String?
  doctorType               DoctorType
  consultationCharges      Float?
  email                    String?    @unique
  phoneNumber              String?    @unique
  emergencyContact         String?
  consultationStartingTime String?
  consultationEndingTime   String?
  createdBy                Int?
  updatedBy                Int?
  deletedBy                Int?

  createdByUser User? @relation("DoctorCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("DoctorUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User? @relation("DoctorDeletedBy", fields: [deletedBy], references: [id])

  availableDays DoctorAvailableDay[]
  appointment   Appointment[]
  consultingOpd Opd[]                @relation("ConsultantDoctorOpds")
  referringOpd  Opd[]                @relation("ReferringDoctorOpds")
  consultingIpd Ipd[]                @relation("ConsultantDoctorIpds")
  referringIpd  Ipd[]                @relation("ReferringDoctorIpds")
  drugBills     DrugBill[]
  consultingService Service?         @relation("ConsultingDoctorService")

  @@index([createdBy])
  @@index([updatedBy])
  @@index([userId])
}

model DoctorAvailableDay {
  id       Int    @id @default(autoincrement())
  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  day      Days

  @@unique([doctorId, day])
  @@index([doctorId])
}

model PatientContact {
  id    Int         @id @default(autoincrement())
  type  ContactType
  value String

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([type, patientId])
  @@index([patientId])
}

model emergencyContact {
  id       Int     @id @default(autoincrement())
  name     String
  contact  String
  relation String
  email    String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientNotes {
  id   Int    @id @default(autoincrement())
  type String
  note String

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientRelations {
  id      Int              @id @default(autoincrement())
  type    RelationshipType
  name    String
  contact String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, name, type])
  @@index([patientId])
}

model PatientAddress {
  id               Int         @id @default(autoincrement())
  type             AddressType @default(HOME)
  addressLineOne   String
  addressLineTwo   String?
  addressLineThree String?
  patientId        Int
  locationId       Int?
  location         Location?   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  patient          Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([type, patientId])
  @@index([patientId])
  @@index([locationId])
}

model PatientIdentification {
  id     Int          @id @default(autoincrement())
  type   IdentityType
  number String
  active Status

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([type, patientId])
  @@index([patientId])
}

model Patient {
  id                 Int            @id @default(autoincrement())
  title              NameTitle
  firstName          String
  middleName         String?
  lastName           String
  preferredName      String?
  dob                DateTime
  identificationMark String?
  gender             Gender
  maritalStatus      MaritalStatus?
  religion           String?
  bloodGroup         BloodGroup?
  createdBy          Int?
  updatedBy          Int?
  deletedBy          Int?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  createdByUser User? @relation("PatientCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("PatientUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User? @relation("PatientDeletedBy", fields: [deletedBy], references: [id])

  appointment         Appointment[]
  contacts            PatientContact[]
  relations           PatientRelations[]
  addresses           PatientAddress[]
  identifications     PatientIdentification[]
  emergencyContacts   emergencyContact[]
  notes               PatientNotes[]
  opds                Opd[]
  ipds                Ipd[]
  pathologyTestOrders PathologyTestOrder[]
  radiologyTestOrders RadiologyTestOrder[]
  beds                Bed[]
  drugBills           DrugBill[]

  @@index([createdAt])
  @@index([createdBy])
}

// -------------------- Facility Management --------------------
model Department {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  status      Status     @default(active)
  isDeleted   Boolean    @default(false)
  createdBy   Int?
  updatedBy   Int?
  deletedBy   Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  roomTypes   RoomType[]

  createdByUser User? @relation("DepartmentCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("DepartmentUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User? @relation("DepartmentDeletedBy", fields: [deletedBy], references: [id])
}

model RoomType {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  description  String?
  departmentId Int

  status        Status     @default(active)
  isDeleted     Boolean    @default(false)
  createdBy     Int?
  updatedBy     Int?
  deletedBy     Int?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdByUser User?      @relation("RoomTypeCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?      @relation("RoomTypeUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?      @relation("RoomTypeDeletedBy", fields: [deletedBy], references: [id])

  rooms Room[]

  @@index([departmentId])
}

model Room {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  roomTypeId  Int
  price       Float   @default(0)

  status    Status  @default(active)
  isDeleted Boolean @default(false)
  createdBy Int?
  updatedBy Int?
  deletedBy Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  roomType      RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  createdByUser User?    @relation("RoomCreatedBy", fields: [createdBy], references: [id])
