// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// --------------------
// Configurations
// --------------------
datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// --------------------
// Enums
// --------------------
enum Status {
  active
  inactive
}

enum DoctorType {
  referring
  consulting
}

enum Days {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum Gender {
  Male
  Female
  Other
}

enum MaritalStatus {
  Single
  Married
  Divorced
  Widowed
}

enum PatientType {
  General
  Emergency
  VIP
}

enum IdentityType {
  ADHAR_CARD
  DRIVING_LICENSE
  PAN_CARD
  VOTER_CARD
}

enum DocumentType {
  ALL_TYPES_OF_DOCUMENT
  BIRTH_CERTIFICATE
  CONSENT_FORM
  DEATH_CERTIFICATE
  EMPLOYMENT_CODE_OF_CONDUCT_DOCUMENT
  EMPLOYMENT_EXPERIENCE_LETTER
  EMPLOYMENT_LEGAL_DOCUMENT
  EMPLOYMENT_OFFER_LETTER
  EMPLOYMENT_OTHER_DOCUMENT
  EMPLOYMENT_PAY_SLIP_PAY_ADVICE
  EMPLOYMENT_RECOMMENDATION_LETTER
  EMPLOYMENT_ROLES_AND_RESPONSIBILITIES
  EMPLOYMENT_TERMINATION_LETTER
  EMPLOYMENT_TERMS_AND_CONDITIONS_DOCUMENT
  IDENTIFICATION_DOCUMENT
  INSURANCE_DOCUMENT
  INVOICE_DOCUMENT
  LAB_REPORT
  LEGAL_DOCUMENT
  MEDICAL_CERTIFICATE
  MEDICO_LEGAL_DOCUMENT
  OTHER_CERTIFICATE_OR_CORRESPONDENCE
  OTHER_DOCUMENT
  PATIENT_TRANSFER_DOCUMENT
  PAYMENT_RECEIPT
  PHOTOS
  PRESCRIPTION
  PROFILE_PICTURE
  REPORT
  TRAVEL_DOCUMENT
}

enum AppointmentType {
  CONSULTATION
  CONTRACEPTION
  EDD
  EYE_CARE
  GETTING_STARTED
  MAMMOGRAMS
  OPERATION
  OTHER
  ROUTINE_CHECKUP
  SAME_DAY_ASSISTANCE
  SICK_VISIT
  SURGERY
  TRAVEL_CLINIC
  VACCINATIONS
}

enum ReferenceRangeSex {
  MALE
  FEMALE
  Both
}

enum ServiceType {
  LAB_TEST
  RADIOLOGY_TEST
  CLINICAL_TEST
  OTHER
}

enum ServiceApplicableOn {
  INPATIENT
  OUTPATIENT
  CONSULTATION
  BOTH
}

enum SampleType {
  CSF
  ASCITIC_FLUID
  OTHER
  PERICARDIAL_FLUID
  PERITONEAL_FLUID
  PLASMA
  PLEURAL_FLUID
  PUS
  SEMEN
  SERUM
  SPUTUM
  STOOL
  SYNOVIAL_FLUID
  URINE
  WHOLE_BLOOD
  WHOLE_BLOOD_SERUM
}

enum ResultType {
  NUMERIC
  TEXT
  BOOLEAN
  DETECTION
  IMAGE
  PDF
}

enum ModuleType {
  USER
  DOCTOR_MASTER
  FLOOR_MASTER
  WARD_MASTER
  BED_MASTER
  APPOINTMENT
  PATIENT_MASTER
  BILLING_SECTION_MASTER
  SERVICE_MASTER
  PATHOLOGY_TEST_MASTER
  RADIOLOGY_TEST_MASTER
  OPD_BILL
  OPD_QUEUE
  PATHOLOGY_ORDER
  RADIOLOGY_ORDER
  LOCATION_MASTER
  INVOICE
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
  PRINT
  VIEW
}

enum ContactType {
  EMAIL
  PHONE
  MOBILE
}

enum BloodGroup {
  A_PLUS
  A_NEGATIVE
  B_PLUS
  B_NEGATIVE
  AB_PLUS
  AB_NEGATIVE
  O_PLUS
  O_NEGATIVE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PathologyTestSection {
  BIOCHEMISTRY
  CLINICAL_PATHOLOGY
  COAGULATION
  CYTOGENETICS
  CYTOPATHOLOGY
  HAEMATOLOGY
  HISTOPATHOLOGY
  HORMONES_IMMUNOLOGY
  IMMUNOASSAY
  IMMUNOFLUORESCENCE
  MICROBIOLOGY
  MOLECULAR_BIOLOGY
  NEPHELOMETRY
  SEROLOGY
  TRANSFUSION_MEDICINE
}

enum ContainerType {
  CLOT_ACTIVATOR
  EDTA
  EDTA_CLOT_ACTIVATOR
  EDTA_CITRATE_ACTIVATOR
  SODIUM_CITRATE_3_2
  OTHER
}

enum RadiologySection {
  COAGULATION
  CT_SCAN
  CYTOGENETICS
  CYTOPATHOLOGY
  HISTOPATHOLOGY
  IMMUNOASSAY
  IMMUNOFLUORESCENCE
  MICROBIOLOGY
  MOLECULAR_BIOLOGY
  MRI
  NEPHELOMETRY
  SONOGRAPHY_ULTRASOUND
  TRANSFUSION_MEDICINE
  X_RAY
}

enum OpdArrival {
  ROUTINE
  APPOINTMENT
  FOLLOW_UP
  EMERGENCY
  AYUSHMAN_NEW_IP
  AYUSHMAN_IP_FIRST
  AYUSHMAN_IP_SECOND
  AYUSHMAN_IP_THIRD
  OTHER
}

enum DiscountType {
  PERCENTAGE
  VALUE
}

enum PaymentCategory {
  CASHLESS_INSURANCE
  CORPORATE_AFFILIATION
  AYUSHMAN_BHARAT
  CGHS
  RGHS
  CHIRANJIVI_YOJNA
  GOVERNMENT_BENEFITS
  NOT_DETERMINED
  SELF_PAY
  DO_NOT_CONSIDER
}

enum PaymentMode {
  PAYMENT_MODE_DEFAULT
  CASH
  CARD_PAYMENT
  CHEQUE
  DIGITAL_WALLET
  INSURANCE
  INTERNAL_ADJUSTMENTS
  LOYALTY_CARD
  NEFT
  RTGS
  TDS_AYUSHMAN_BHARAT
  TDS_CHIRANJIVI_YOJNA
  TDS_OTHERS
  TDS
  OTHER
}

enum PathologyOrderStatus {
  SAMPLE_PENDING
  RESULT_PENDING
  COMPLETED
}

enum RadiologyOrderStatus {
  RESULT_PENDING
  COMPLETED
}

enum NameTitle {
  DR
  MR
  MS
  MRS
  BABY
  MASTER
}

enum AddressType {
  BILLING
  CONTACT
  BUSINESS
  HOME
  POSTAL
  SHIPPING
}

enum RelationshipType {
  NONE
  WIFE_OF
  HUSBAND_OF
  SON_OF
  DAUGHTER_OF
  BROTHER_OF
  SISTER_OF
  FATHER_OF
  MOTHER_OF
  OTHER
}

// --------------------
// Models
// --------------------

// -------------------- Location Management --------------------

model Location {
  id               Int              @id @default(autoincrement())
  city             String
  state            String
  country          String
  postcode         String
  patientAddresses PatientAddress[]

  @@index([city])
  @@index([postcode])
}

// -------------------- Permission Management --------------------
model Action {
  id          Int          @id @default(autoincrement())
  name        ActionType   @unique
  permissions Permission[]
}

model Module {
  id          Int          @id @default(autoincrement())
  name        ModuleType   @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now())
  permissions Permission[]
}

model Permission {
  id       Int @id @default(autoincrement())
  moduleId Int
  actionId Int

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  userPermissions UserPermission[]

  @@unique([moduleId, actionId])
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([permissionId, userId])
}

// -------------------- User Management --------------------

model User {
  id       Int       @id @default(autoincrement())
  username String    @unique
  loginId  String    @unique
  title    NameTitle @default(MR)
  password String
  status   Status    @default(active)
  name     String?
  doctor   Doctor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions             UserPermission[]
  transactions            Transaction[]
  verifiedPathology       PathologyTestOrder[] @relation("verifiedPathology")
  resultEnteredPathology  PathologyTestOrder[] @relation("resultEnteredPathology")
  sampleTakenPathology    PathologyTestOrder[] @relation("sampleTakenPathology")
  cancelledTakenPathology PathologyTestOrder[] @relation("cancelledTakenPathology")
  verifiedRadiology       RadiologyTestOrder[] @relation("verifiedRadiology")
  resultEnteredRadiology  RadiologyTestOrder[] @relation("resultEnteredRadiology")
  sampleTakenRadiology    RadiologyTestOrder[] @relation("sampleTakenRadiology")
  cancelledTakenRadiology RadiologyTestOrder[] @relation("cancelledTakenRadiology")
}

model Doctor {
  userId                   Int        @id
  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber            String     @unique
  specialization           String
  qualifications           String
  yearsExperience          Int
  department               String?
  designation              String?
  doctorType               DoctorType
  email                    String     @unique
  phoneNumber              String     @unique
  emergencyContact         String?
  consultationStartingTime String?
  consultationEndingTime   String?

  availableDays DoctorAvailableDay[]
  appointment   Appointment[]
  consultingOpd Opd[]                @relation("ConsultantDoctorOpds")
  referringOpd  Opd[]                @relation("ReferringDoctorOpds")
}

model DoctorAvailableDay {
  id       Int    @id @default(autoincrement())
  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  day      Days

  @@unique([doctorId, day])
}

model PatientContact {
  id    Int         @id @default(autoincrement())
  type  ContactType
  value String

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([type, patientId])
}

model emergencyContact {
  id       Int     @id @default(autoincrement())
  name     String
  contact  String
  relation String
  email    String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientNotes {
  id   Int    @id @default(autoincrement())
  type String
  note String

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PatientRelations {
  id      Int              @id @default(autoincrement())
  type    RelationshipType
  name    String
  contact String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, name, type])
}

model PatientAddress {
  id               Int         @id @default(autoincrement())
  type             AddressType @default(HOME)
  addressLineOne   String
  addressLineTwo   String?
  addressLineThree String?
  patientId        Int
  locationId       Int?
  location         Location?   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  patient          Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([type, patientId])
}

model PatientIdentification {
  id     Int          @id @default(autoincrement())
  type   IdentityType
  number String
  active Status

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([type, patientId])
}

model Patient {
  id                 Int            @id @default(autoincrement())
  uhid               String         @unique @default(uuid())
  title              NameTitle
  firstName          String
  middleName         String?
  lastName           String
  preferredName      String?
  dob                DateTime
  identificationMark String?
  gender             Gender
  maritalStatus      MaritalStatus?
  religion           String?
  bloodGroup         BloodGroup?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  appointment         Appointment[]
  contacts            PatientContact[]
  relations           PatientRelations[]
  addresses           PatientAddress[]
  identifications     PatientIdentification[]
  emergencyContacts   emergencyContact[]
  notes               PatientNotes[]
  opds                Opd[]
  pathologyTestOrders PathologyTestOrder[]
  radiologyTestOrders RadiologyTestOrder[]
}

// -------------------- Facility Management --------------------
model Floor {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  departments Ward[]
  status      Status   @default(active)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ward {
  id          Int      @id @default(autoincrement())
  floorId     Int
  floor       Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name        String   @unique
  description String?
  status      Status   @default(active)
  beds        Bed[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Bed {
  id        Int      @id @default(autoincrement())
  wardId    Int
  ward      Ward     @relation(fields: [wardId], references: [id], onDelete: Cascade)
  bedNumber String
  status    Status   @default(active)
  occupied  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------- Appointment Management --------------------
model Appointment {
  id              Int               @id @default(autoincrement())
  patientId       Int
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        Int
  doctor          Doctor            @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  appointmentDate DateTime
  remarks         String?
  type            AppointmentType
  status          AppointmentStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// -------------------- Pathology Lab Test Management --------------------
model PathologyTest {
  id          Int                  @id @default(autoincrement())
  name        String               @unique
  alias       String
  price       Float
  status      Status               @default(active)
  section     PathologyTestSection
  container   ContainerType
  sampleType  SampleType
  footerNotes String?

  parameters PathologyTestParameter[]
  services   PathologyTestService[]

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  testHeaders           PathologyTestHeader[]
  advisedPathologyTests AdvisedPathologyTests[]
  pathologyTestOrders   PathologyTestOrder[]
}

model PathologyTestHeader {
  id           Int      @id @default(autoincrement())
  name         String
  note         String?
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  testId         Int
  test           PathologyTest            @relation(fields: [testId], references: [id], onDelete: Cascade)
  testParameters PathologyTestParameter[]
}

model PathologyTestParameter {
  id                   Int                   @id @default(autoincrement())
  headerId             Int?
  header               PathologyTestHeader?  @relation(fields: [headerId], references: [id], onDelete: Cascade)
  name                 String
  displayOrder         Int
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  test                 PathologyTest?        @relation(fields: [testId], references: [id])
  testId               Int?
  isDescriptiveOnly    Boolean               @default(false)
  referenceRanges      ReferenceRange[]
  parameterOptions     ParameterOptions[]
  pathologyTestResults PathologyTestResult[]
}

model ParameterOptions {
  id              Int                    @id @default(autoincrement())
  testParameterId Int
  testParameter   PathologyTestParameter @relation(fields: [testParameterId], references: [id], onDelete: Cascade)
  value           String
}

model ReferenceRange {
  id Int @id @default(autoincrement())

  testParameterId Int
  testParameter   PathologyTestParameter @relation(fields: [testParameterId], references: [id], onDelete: Cascade)

  applicableGender ReferenceRangeSex
  lowerAgeInDays   Int?
  upperAgeInDays   Int?
  lowerRange       Int?
  upperRange       Int?
  unit             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------- Pathology Lab Order Management --------------------
model PathologyTestOrder {
  id        Int @id @default(autoincrement())
  opdId     Int
  patientId Int
  testId    Int

  sampleTakenAt     DateTime?
  resultEnteredAt   DateTime?
  verifiedAt        DateTime?
  sampleTakenById   Int?
  resultEnteredById Int?
  verifiedById      Int?
  cancelledById     Int?
  isOutSourced      Boolean   @default(false)
  isCancelled       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verifiedBy      User?                 @relation("verifiedPathology", fields: [verifiedById], references: [id])
  resultEnteredBy User?                 @relation("resultEnteredPathology", fields: [resultEnteredById], references: [id])
  sampleTakenBy   User?                 @relation("sampleTakenPathology", fields: [sampleTakenById], references: [id])
  cancelledByUser User?                 @relation("cancelledTakenPathology", fields: [cancelledById], references: [id])
  patient         Patient               @relation(fields: [patientId], references: [id])
  test            PathologyTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  status          PathologyOrderStatus  @default(SAMPLE_PENDING)
  results         PathologyTestResult[]
  opd             Opd                   @relation(fields: [opdId], references: [id], onDelete: Cascade)
}

model PathologyTestResult {
  id           Int     @id @default(autoincrement())
  orderId      Int
  parameterId  Int
  numericValue Float?
  textValue    String?
  optionId     Int?

  remark String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     PathologyTestOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parameter PathologyTestParameter @relation(fields: [parameterId], references: [id])
}

// -------------------- Radiology Lab Order Management --------------------
model RadiologyTestOrder {
  id        Int @id @default(autoincrement())
  opdId     Int
  patientId Int
  testId    Int

  sampleTakenAt     DateTime?
  resultEnteredAt   DateTime?
  verifiedAt        DateTime?
  sampleTakenById   Int?
  resultEnteredById Int?
  verifiedById      Int?
  cancelledById     Int?
  isOutSourced      Boolean   @default(false)
  isCancelled       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  verifiedBy      User?                 @relation("verifiedRadiology", fields: [verifiedById], references: [id])
  resultEnteredBy User?                 @relation("resultEnteredRadiology", fields: [resultEnteredById], references: [id])
  sampleTakenBy   User?                 @relation("sampleTakenRadiology", fields: [sampleTakenById], references: [id])
  cancelledByUser User?                 @relation("cancelledTakenRadiology", fields: [cancelledById], references: [id])
  patient         Patient               @relation(fields: [patientId], references: [id])
  test            RadiologyTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  status          RadiologyOrderStatus  @default(RESULT_PENDING)
  results         RadiologyTestResult[]
  opd             Opd                   @relation(fields: [opdId], references: [id], onDelete: Cascade)
}

model RadiologyTestResult {
  id         Int     @id @default(autoincrement())
  orderId    Int
  templateId Int
  value      String? @db.LongText

  remark String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    RadiologyTestOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  template RadiologyTemplate  @relation(fields: [templateId], references: [id])
}

// -------------------- Radiology Test Management --------------------
model RadiologyTest {
  id         Int              @id @default(autoincrement())
  name       String           @unique
  alias      String
  price      Float
  status     Status           @default(active)
  section    RadiologySection
  templateId Int?

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  radiologyTestServices RadiologyTestService[]
  advisedRadiologyTests AdvisedRadiologyTests[]
  template              RadiologyTemplate?      @relation(fields: [templateId], references: [id])
  radiologyTestOrders   RadiologyTestOrder[]
}

model RadiologyTemplate {
  id      Int              @id @default(autoincrement())
  section RadiologySection
  name    String
  content String           @db.LongText
  status  Status           @default(active)

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  radiologyTests       RadiologyTest[]
  radiologyTestResults RadiologyTestResult[]
}

// -------------------- Service Management --------------------
model BillingSection {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  status      Status  @default(active)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  invoiceBillingItems InvoiceBillingItem[]
}

model Service {
  id                Int                    @id @default(autoincrement())
  name              String
  description       String?
  type              ServiceType
  price             Float
  discountAvailable Boolean                @default(false)
  maxDiscount       Float?                 @default(0)
  applicableOn      ServiceApplicableOn    @default(BOTH)
  status            Status                 @default(active)
  pathologyTests    PathologyTestService[]
  radiologyTests    RadiologyTestService[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  invoiceBillingItems InvoiceBillingItem[]
}

model PathologyTestService {
  id        Int @id @default(autoincrement())
  testId    Int
  serviceId Int

  test    PathologyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, serviceId])
}

model RadiologyTestService {
  id        Int @id @default(autoincrement())
  testId    Int
  serviceId Int

  test    RadiologyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, serviceId])
}

// -------------------- Transactions Management --------------------
model Transaction {
  id      Int         @id @default(autoincrement())
  opdId   Int?
  amount  Float
  mode    PaymentMode
  remarks String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  receivedById Int

  receivedBy User     @relation(fields: [receivedById], references: [id])
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId  Int?
}

model InvoiceBillingItem {
  id               Int          @id @default(autoincrement())
  opdId            Int?
  billingSectionId Int
  serviceId        Int
  quantity         Int
  rate             Float
  discountType     DiscountType
  discountValue    Float
  total            Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingSection BillingSection @relation(fields: [billingSectionId], references: [id], onDelete: Cascade)
  service        Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])
  invoiceId      Int?
}

model Invoice {
  id            Int                  @id @default(autoincrement())
  rate          Float
  discountType  DiscountType
  discountValue Float
  total         Float
  isPaid        Boolean              @default(false)
  isFree        Boolean              @default(false)
  billingType   PaymentCategory
  billingItems  InvoiceBillingItem[]
  transactions  Transaction[]

  opd Opd?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// -------------------- OPD File Management --------------------

model PrescribedDrugs {
  id             Int     @id @default(autoincrement())
  name           String
  frequency      Int
  days           Int
  remarks        String?
  prescriptionId Int
  opdId          Int

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  opd          Opd          @relation(fields: [opdId], references: [id], onDelete: Cascade)
}

model Prescription {
  id                Int       @id @default(autoincrement())
  opdId             Int       @unique
  followUpAfterDays Int?
  followUpDate      DateTime?
  followUpAdvice    String?
  otherAdvice       String?

  drugs PrescribedDrugs[]
  opd   Opd               @relation(fields: [opdId], references: [id], onDelete: Cascade)
}

model Vital {
  id     Int  @id @default(autoincrement())
  opdId  Int  @unique
  height Int?
  weight Int?
  bpMm   Int?
  bpHg   Int?
  pulse  Int?
  rbs    Int?
  rr     Int?
  spo2   Int?
  temp   Int?

  opdConsultation OpdConsultation?
  opd             Opd              @relation(fields: [opdId], references: [id], onDelete: Cascade)
}

model AdvisedPathologyTests {
  id             Int @id @default(autoincrement())
  testId         Int
  consultationId Int
  opdId          Int

  test         PathologyTest   @relation(fields: [testId], references: [id], onDelete: Cascade)
  consultation OpdConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  opd          Opd             @relation(fields: [opdId], references: [id], onDelete: Cascade)

  @@unique([opdId, testId])
}

model AdvisedRadiologyTests {
  id             Int @id @default(autoincrement())
  testId         Int
  consultationId Int
  opdId          Int

  test         RadiologyTest   @relation(fields: [testId], references: [id], onDelete: Cascade)
  consultation OpdConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  opd          Opd             @relation(fields: [opdId], references: [id], onDelete: Cascade)

  @@unique([opdId, testId])
}

model OpdConsultation {
  id                   Int     @id @default(autoincrement())
  opdId                Int     @unique
  vitalsId             Int     @unique
  notes                String?
  generalExaminations  String?
  systemicExaminations String?
  diagnosis            String?
  chronicIllness       String?

  opd                   Opd                     @relation(fields: [opdId], references: [id], onDelete: Cascade)
  vitals                Vital                   @relation(fields: [vitalsId], references: [id], onDelete: Cascade)
  advisedPathologyTests AdvisedPathologyTests[]
  advisedRadiologyTests AdvisedRadiologyTests[]
}

// -------------------- Opd Management --------------------

model Opd {
  id                 Int        @id @default(autoincrement())
  patientId          Int
  arrivalState       OpdArrival
  remarks            String?
  consultantDoctorId Int
  referringDoctorId  Int?
  isInQueue          Boolean    @default(true)
  invoiceId          Int        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultantDoctor      Doctor                  @relation("ConsultantDoctorOpds", fields: [consultantDoctorId], references: [userId], onDelete: Cascade)
  referringDoctor       Doctor?                 @relation("ReferringDoctorOpds", fields: [referringDoctorId], references: [userId], onDelete: Cascade)
  patient               Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  invoice               Invoice                 @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  consultation          OpdConsultation?
  vital                 Vital?
  advisedPathologyTests AdvisedPathologyTests[]
  advisedRadiologyTests AdvisedRadiologyTests[]
  prescription          Prescription?
  prescribedDrugs       PrescribedDrugs[]
  pathologyTestOrders   PathologyTestOrder[]
  radiologyTestOrders   RadiologyTestOrder[]
}
