  billingSection  BillingSection       @relation(fields: [billingSectionId], references: [id], onDelete: Cascade)
  items           InvoiceBillingItem[]
  createdByUser   User?                @relation("InvoiceBillingSectionCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   User?                @relation("InvoiceBillingSectionUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser   User?                @relation("InvoiceBillingSectionDeletedBy", fields: [deletedBy], references: [id])

  @@unique([invoiceId, billingSectionId])
