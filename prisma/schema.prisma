// -------------------- Service Management --------------------
model BillingSection {
  id                          Int     @id @default(autoincrement())
  name                        String  @unique
  systemKey                   String? @unique
  isOtherCharges              Boolean @default(false)
  isDoctorConsultationCharges Boolean @default(false)
  description                 String?
  status                      Status  @default(active)
  isDeleted                   Boolean @default(false)
  createdBy                   Int?
  updatedBy                   Int?
  deletedBy                   Int?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  createdByUser       User?                @relation("BillingSectionCreatedBy", fields: [createdBy], references: [id])
  updatedByUser       User?                @relation("BillingSectionUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser       User?                @relation("BillingSectionDeletedBy", fields: [deletedBy], references: [id])
  invoiceBillingSections InvoiceBillingSection[]
  invoiceBillingItems InvoiceBillingItem[]
}

model Service {
  id                Int                    @id @default(autoincrement())
  name              String
  description       String?
  isInvoiceOnly     Boolean                @default(false)
  type              ServiceType
  price             Float
  discountAvailable Boolean                @default(false)
  maxDiscount       Float?                 @default(0)
  applicableOn      ServiceApplicableOn    @default(BOTH)
  status            Status                 @default(active)
  isDeleted         Boolean                @default(false)
  createdBy         Int?
  updatedBy         Int?
  deletedBy         Int?
