model Doctor {
  userId                   Int        @id
  user                     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber            String?    @unique
  specialization           String?
  qualifications           String?
  yearsExperience          Int?
  department               String?
  designation              String?
  doctorType               DoctorType
  consultationCharges      Float?
  email                    String?    @unique
  phoneNumber              String?    @unique
  emergencyContact         String?
  consultationStartingTime String?
  consultationEndingTime   String?
  createdBy                Int?
  updatedBy                Int?
  deletedBy                Int?

  createdByUser User? @relation("DoctorCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("DoctorUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User? @relation("DoctorDeletedBy", fields: [deletedBy], references: [id])

  availableDays     DoctorAvailableDay[]
  appointment       Appointment[]
  consultingOpd     Opd[]                @relation("ConsultantDoctorOpds")
  referringOpd      Opd[]                @relation("ReferringDoctorOpds")
  consultingIpd     Ipd[]                @relation("ConsultantDoctorIpds")
  referringIpd      Ipd[]                @relation("ReferringDoctorIpds")
  drugBills         DrugBill[]
  consultingService Service?             @relation("ConsultingDoctorService")

  @@index([createdBy])
  @@index([updatedBy])
  @@index([userId])
}

model DoctorAvailableDay {
  id       Int    @id @default(autoincrement())
  doctorId Int
  doctor   Doctor @relation(fields: [doctorId], references: [userId], onDelete: Cascade)
  day      Days

  @@unique([doctorId, day])
  @@index([doctorId])
}

model PatientContact {
  id    Int         @id @default(autoincrement())
  type  ContactType
  value String

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([type, patientId])
  @@index([patientId])
}

model emergencyContact {
  id       Int     @id @default(autoincrement())
  name     String
  contact  String
  relation String
  email    String?

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientNotes {
  id   Int    @id @default(autoincrement())
  type String
  note String

  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model PatientRelations {
  id      Int              @id @default(autoincrement())
  type    RelationshipType
  name    String
