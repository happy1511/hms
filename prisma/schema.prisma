  createdByUser User?                 @relation("IpdDirectReturnCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?                 @relation("IpdDirectReturnUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?                 @relation("IpdDirectReturnDeletedBy", fields: [deletedBy], references: [id])

  @@index([ipdId])
  @@index([isDeleted])
  @@index([createdAt])
}

model IpdDirectReturnItem {
  id                   Int      @id @default(autoincrement())
  ipdDirectReturnId    Int
  ipdDirectIssueItemId Int
  inventoryItemId      Int
  quantity             Int
  isLooseQuantity      Boolean  @default(false)
  rate                 Float
  taxableAmount        Float    @default(0)
  gstPercentage        Float    @default(0)
  cGstPercentage       Float    @default(0)
  sGstPercentage       Float    @default(0)
  iGstPercentage       Float    @default(0)
  gstAmount            Float    @default(0)
  cGstAmount           Float    @default(0)
  sGstAmount           Float    @default(0)
  iGstAmount           Float    @default(0)
  total                Float
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  ipdDirectReturn IpdDirectReturn    @relation(fields: [ipdDirectReturnId], references: [id], onDelete: Cascade)
  issueItem       IpdDirectIssueItem @relation(fields: [ipdDirectIssueItemId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItems     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([ipdDirectReturnId])
  @@index([ipdDirectIssueItemId])
  @@index([inventoryItemId])
}

model SaleReturn {
  id                  Int         @id @default(autoincrement())
  drugBillId          Int
  refundAmount        Float       @default(0)
  refundMode          PaymentMode @default(CASH)
  remarks             String?
  refundTransactionId Int?        @unique
  isDeleted           Boolean     @default(false)
  createdBy           Int?
  updatedBy           Int?
  deletedBy           Int?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  drugBill          DrugBill         @relation(fields: [drugBillId], references: [id], onDelete: Cascade)
  refundTransaction Transaction?     @relation(fields: [refundTransactionId], references: [id], onDelete: SetNull)
  items             SaleReturnItem[]
  createdByUser     User?            @relation("SaleReturnCreatedBy", fields: [createdBy], references: [id])
  updatedByUser     User?            @relation("SaleReturnUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser     User?            @relation("SaleReturnDeletedBy", fields: [deletedBy], references: [id])

  @@index([drugBillId])
  @@index([isDeleted])
}

model SaleReturnItem {
  id              Int          @id @default(autoincrement())
  saleReturnId    Int
  drugSaleItemId  Int
  inventoryItemId Int
  quantity        Int
  isLooseQuantity Boolean      @default(false)
  rate            Float
  discountType    DiscountType @default(VALUE)
  discountValue   Float        @default(0)
  taxableAmount   Float        @default(0)
  gstPercentage   Float        @default(0)
  cGstPercentage  Float        @default(0)
  sGstPercentage  Float        @default(0)
  iGstPercentage  Float        @default(0)
  gstAmount       Float        @default(0)
  cGstAmount      Float        @default(0)
  sGstAmount      Float        @default(0)
  iGstAmount      Float        @default(0)
  total           Float
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  saleReturn    SaleReturn     @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem      DrugSaleItem   @relation(fields: [drugSaleItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItems @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([saleReturnId])
  @@index([drugSaleItemId])
  @@index([inventoryItemId])
}

model SupplierReturn {
  id            Int      @id @default(autoincrement())
  supplierId    Int
  returnDate    DateTime
  returnReason  String?  @db.LongText
  taxableAmount Float    @default(0)
  cGstAmount    Float    @default(0)
  sGstAmount    Float    @default(0)
  iGstAmount    Float    @default(0)
  total         Float    @default(0)
  isDeleted     Boolean  @default(false)
  createdBy     Int?
  updatedBy     Int?
  deletedBy     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier      DrugSupplier         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items         SupplierReturnItem[]
  createdByUser User?                @relation("SupplierReturnCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?                @relation("SupplierReturnUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?                @relation("SupplierReturnDeletedBy", fields: [deletedBy], references: [id])

  @@index([supplierId])
  @@index([returnDate])
  @@index([isDeleted])
}

model SupplierPayment {
  id          Int                 @id @default(autoincrement())
  supplierId  Int
  type        SupplierPaymentType
  paymentDate DateTime
  amount      Float               @default(0)
  reference   String?             @db.LongText
  isDeleted   Boolean             @default(false)
  createdBy   Int?
  updatedBy   Int?
  deletedBy   Int?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  supplier      DrugSupplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  allocations   SupplierPaymentAllocation[]
  createdByUser User?                       @relation("SupplierPaymentCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?                       @relation("SupplierPaymentUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?                       @relation("SupplierPaymentDeletedBy", fields: [deletedBy], references: [id])

  @@index([supplierId])
  @@index([type])
  @@index([paymentDate])
  @@index([isDeleted])
}

model SupplierPaymentAllocation {
  id                Int      @id @default(autoincrement())
  supplierPaymentId Int
  grnId             Int
  amount            Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplierPayment SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)
  grn             GRN             @relation(fields: [grnId], references: [id], onDelete: Cascade)

  @@unique([supplierPaymentId, grnId])
  @@index([supplierPaymentId])
  @@index([grnId])
}

model SupplierReturnItem {
  id               Int      @id @default(autoincrement())
  supplierReturnId Int
  inventoryItemId  Int
  quantity         Int
  isLooseQuantity  Boolean  @default(false)
  rate             Float
  taxableAmount    Float    @default(0)
  gstPercentage    Float    @default(0)
  cGstPercentage   Float    @default(0)
  sGstPercentage   Float    @default(0)
  iGstPercentage   Float    @default(0)
  cGstAmount       Float    @default(0)
  sGstAmount       Float    @default(0)
  iGstAmount       Float    @default(0)
  total            Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplierReturn SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItems @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([supplierReturnId])
  @@index([inventoryItemId])
}

model GRNItems {
  id              Int  @id @default(autoincrement())
  purchaseItemId  Int?
  challanItemId   Int?
  inventoryItemId Int
  grnId           Int

  grn           GRN            @relation(fields: [grnId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItems @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  purchaseItem  PurchaseItem?  @relation(fields: [purchaseItemId], references: [id], onDelete: Cascade)
  challanItem   ChallanItem?   @relation(fields: [challanItemId], references: [id], onDelete: Cascade)

  @@index([purchaseItemId])
  @@index([challanItemId])
  @@index([inventoryItemId])
  @@index([grnId])
}

model GRN {
  id                Int      @id @default(autoincrement())
  orderId           Int?     @unique
  challanId         Int?     @unique
  invoiceNumber     String
  invoiceDate       DateTime
  discountAmount    Float    @default(0)
  taxableAmount     Float    @default(0)
  cGstAmount        Float    @default(0)
  sGstAmount        Float    @default(0)
  iGstAmount        Float    @default(0)
  tcsAmount         Float    @default(0)
  packingForwarding Float    @default(0)
  roundOffAmount    Float    @default(0)
  grandTotal        Float    @default(0)
  cnAmount          Float    @default(0)
  cnRef             String?
  createdBy         Int?
  updatedBy         Int?
  deletedBy         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  grnItems                   GRNItems[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  order                      PurchaseOrder?              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  challan                    Challan?                    @relation(fields: [challanId], references: [id], onDelete: Cascade)
  createdByUser              User?                       @relation("GRNCreatedBy", fields: [createdBy], references: [id])
  updatedByUser              User?                       @relation("GRNUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser              User?                       @relation("GRNDeletedBy", fields: [deletedBy], references: [id])
}

model ChallanItem {
  id                Int      @id @default(autoincrement())
  challanId         Int
  drugId            Int
  hsnSacId          Int?
  quantity          Int
  freeQuantity      Int      @default(0)
  packaging         String?
  qtyType           String?
  itemsPerPack      Int      @default(1)
  batchNo           String
  expiryDate        DateTime
  manufacturingDate DateTime
  purchasePrice     Float    @default(0)
  mrp               Float    @default(0)
  sellingPrice      Float    @default(0)
  wholeSalePrice    Float    @default(0)
  total             Float    @default(0)
  categoryId        Int?
  inventoryItemId   Int

  challan       Challan              @relation(fields: [challanId], references: [id], onDelete: Cascade)
  category      DrugBillingCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  drug          Drug                 @relation(fields: [drugId], references: [id], onDelete: Cascade)
  hsnSac        HsnSac?              @relation(fields: [hsnSacId], references: [id])
  inventoryItem InventoryItems       @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  grnItems      GRNItems[]

  @@index([challanId])
  @@index([drugId])
  @@index([inventoryItemId])
}

model Challan {
  id                Int      @id @default(autoincrement())
  supplierId        Int
  challanNumber     String   @unique
  invoiceNumber     String
  invoiceDate       DateTime
  discountAmount    Float    @default(0)
  taxableAmount     Float    @default(0)
  cGstAmount        Float    @default(0)
  sGstAmount        Float    @default(0)
  iGstAmount        Float    @default(0)
  tcsAmount         Float    @default(0)
  packingForwarding Float    @default(0)
  roundOffAmount    Float    @default(0)
  grandTotal        Float    @default(0)
  cnAmount          Float    @default(0)
  cnRef             String?
  isDeleted         Boolean  @default(false)
  createdBy         Int?
  updatedBy         Int?
  deletedBy         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  supplier      DrugSupplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items         ChallanItem[]
  grn           GRN?
  createdByUser User?         @relation("ChallanCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?         @relation("ChallanUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?         @relation("ChallanDeletedBy", fields: [deletedBy], references: [id])
}

model PurchaseItem {
  id                 Int   @id @default(autoincrement())
  drugId             Int
  hsnSacId           Int?
  quantity           Int
  categoryId         Int?
  discountPercentage Float @default(0)
  rate               Float @default(0)
  total              Float @default(0)
  purchaseOrderId    Int

  category      DrugBillingCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  drug          Drug                 @relation(fields: [drugId], references: [id], onDelete: Cascade)
  hsnSac        HsnSac?              @relation(fields: [hsnSacId], references: [id])
  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id])
  grnItems      GRNItems[]
}

model PurchaseOrder {
  id                 Int                 @id @default(autoincrement())
  supplierId         Int
  grnId              Int?                @unique
  remarks            String?
  termsAndConditions String?
  orderDate          DateTime            @default(now())
  taxableAmount      Float               @default(0)
  packingForwarding  Float               @default(0)
  cGstAmount         Float               @default(0)
  sGstAmount         Float               @default(0)
  iGstAmount         Float               @default(0)
  tcsAmount          Float               @default(0)
  discountAmount     Float               @default(0)
  roundOffAmount     Float               @default(0)
  grandTotal         Float               @default(0)
  status             PurchaseOrderStatus @default(draft)
  isDeleted          Boolean             @default(false)
  createdBy          Int?
  updatedBy          Int?
  deletedBy          Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt

  supplier      DrugSupplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items         PurchaseItem[]
  grn           GRN?
  createdByUser User?          @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?          @relation("PurchaseOrderUpdatedBy", fields: [updatedBy], references: [id])
  deletedByUser User?          @relation("PurchaseOrderDeletedBy", fields: [deletedBy], references: [id])
}

